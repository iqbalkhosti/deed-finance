# Database (Supabase PostgreSQL)
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string > URI
# Use the "Transaction" pooler mode connection string (port 6543) for Vercel
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Flask
SECRET_KEY=change-this-to-a-random-string

# Email (set DEV_MODE=false to use real SMTP)
DEV_MODE=true
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@deed.com

# LLM Advisor (optional — set to enable AI advisor chat)
LLM_API_KEY=
LLM_PROVIDER=anthropic
